# Copy this file to .env and fill it in:  cp .env.example .env

# Owner login for mypaintpartykits.com/admin
ADMIN_EMAIL=sales@mypaintpartykits.com
ADMIN_PASSWORD=change-me-to-a-long-password

# Random secret that protects the login cookie. Create one with:  openssl rand -hex 32
SESSION_SECRET=

# Web3Forms access key (sends orders and messages to your inbox)
